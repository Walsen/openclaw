{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs ruff check and shellcheck when Python or shell files are edited",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "*.sh"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "ruff check . && ruff format --check . && shellcheck entrypoint.sh",
    "timeout": 30
  }
}
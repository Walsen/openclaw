# Copy to local.env and adjust as needed
# Usage: docker compose --env-file local.env up

# AWS region where your Bedrock models are enabled
AWS_REGION=us-east-1

# AWS profile from ~/.aws/credentials (or leave as "default")
AWS_PROFILE=default

# Bedrock model — must have access enabled in your account
# Options: global.anthropic.claude-sonnet-4-6
#          global.anthropic.claude-haiku-4-5-20251001-v1:0  (cheaper/faster)
#          us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Session identifier — used as the openclaw session ID
SESSION_ID=local-dev
